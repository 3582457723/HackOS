# =====================================
# HackOS Environment Configuration
# =====================================

# =============== 開発環境 ===============
# NODE_ENV=development
# PORT=3000
# CORS_ORIGIN=http://localhost:3000

# =============== 本番環境（Render） ===============
NODE_ENV=production
PORT=10000
CORS_ORIGIN=https://3582457723.github.io

# =============== Socket.IO ===============
# Render では自動的に設定されるため不要
# SOCKET_IO_PORT=10000

# =============== データベース（将来用） ===============
# DATABASE_URL=postgresql://user:pass@localhost/hackosx

# =============== ログレベル ===============
LOG_LEVEL=info
